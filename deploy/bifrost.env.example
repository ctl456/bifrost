# Environment overrides for bifrost.service, read from /etc/bifrost/bifrost.env.
#
# Precedence is defaults, then the configuration file, then this file. It is
# installed with mode 0600 because a secret belongs here rather than in a file
# anyone can read, and every name below is spelled the way the original proxy
# spelled it, so an existing deployment does not need a new set of secrets.
#
# Uncomment what this deployment needs; the rest keeps the value in
# /etc/bifrost/bifrost.toml.
#
# Which file that is cannot be changed from here: the unit names it with `--config`
# on both commands it runs, and a path named on the command line wins over
# `BIFROST_CONFIG`. A variable set here would be accepted and change nothing, which
# is the kind of setting this build does not keep. Edit the unit instead.

# The upstream service. `https://staging-api.commandcode.ai` is the other one.
# CC_API_BASE=https://api.commandcode.ai

# PORT=3050
# HOST=127.0.0.1

# How loud the log is: error, warn, info or debug.
# BIFROST_LOG_LEVEL=info

# The working directory reported upstream. The project slug and the machine the
# fingerprint describes follow it, so this is the one place a deployment says where
# its work happens.
# CC_DEVICE_PROJECT_DIR=/srv/work

# Rotates the derived device identity in bulk. A secret: leave it out to use the
# built-in rule, and know that setting it makes every key look like a new machine
# once.
# CC_FINGERPRINT_SALT=

# Ask the upstream's own model catalogue rather than serving the compiled-in table.
# CC_USE_PROVIDER_MODELS=true

# `[access]` has no name here on purpose. It is the section that says whether this
# deployment forwards its callers' keys or issues tokens of its own, and neither that
# decision nor the paths it names belong in a file that exists to hold secrets the
# original proxy also had: a variable this file accepted and nothing read would be the
# setting this build keeps removing. It goes in /etc/bifrost/bifrost.toml.

# Ask the upstream to route only through zero-data-retention providers.
# CMD_ZDR=false
