    {
      "name": "reasoning a message and its calls become one assistant turn",
      "request": {
        "input": [
          {
            "type": "message",
            "role": "user",
            "content": "search for cats"
          },
          {
            "type": "reasoning",
            "summary": [
              {
                "type": "summary_text",
                "text": "I should "
              },
              {
                "type": "summary_text",
                "text": "search"
              }
            ]
          },
          {
            "type": "message",
            "role": "assistant",
            "content": [
              {
                "type": "output_text",
                "text": "on it"
              }
            ]
          },
          {
            "type": "function_call",
            "call_id": "call_1",
            "name": "search",
            "arguments": "{\"q\":\"cats\"}"
          },
          {
            "type": "function_call",
            "call_id": "call_2",
            "name": "fetch",
            "arguments": {
              "url": "https://x"
            }
          },
          {
            "type": "function_call_output",
            "call_id": "call_1",
            "output": "found 3"
          },
          {
            "type": "function_call_output",
            "call_id": "call_2",
            "output": {
              "count": 2
            }
          }
        ]
      },
      "params": {
        "model": "deepseek/deepseek-v4-flash",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "search for cats"
              }
            ]
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "reasoning",
                "text": "I should search"
              },
              {
                "type": "text",
                "text": "on it"
              },
              {
                "type": "tool-call",
                "toolCallId": "call_1",
                "toolName": "search",
                "input": {
                  "q": "cats"
                }
              },
              {
                "type": "tool-call",
                "toolCallId": "call_2",
                "toolName": "fetch",
                "input": {
                  "url": "https://x"
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": [
              {
                "type": "tool-result",
                "toolCallId": "call_1",
                "toolName": "search",
                "output": {
                  "type": "text",
                  "value": "found 3"
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": [
              {
                "type": "tool-result",
                "toolCallId": "call_2",
                "toolName": "fetch",
                "output": {
                  "type": "text",
                  "value": "{\"count\":2}"
                }
              }
            ]
          }
        ],
        "max_tokens": 64000,
        "stream": true,
        "system": [
          {
            "type": "text",
            "text": " "
          }
        ],
        "tools": []
      }
    },
