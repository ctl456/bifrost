            "role": "tool",
            "tool_call_id": "call_1",
            "content": "found 3"
          },
          {
            "role": "tool",
            "tool_call_id": "call_2",
            "name": "fallback_name",
            "content": [
              {
                "type": "text",
                "text": "a"
              },
              {
                "type": "text",
                "text": "b"
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call_missing",
            "content": "orphan"
          }
        ]
      },
      "params": {
        "model": "deepseek/deepseek-v4-flash",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "search"
              }
            ]
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "reasoning",
                "text": "I should search"
              },
              {
                "type": "text",
                "text": "on it"
              },
              {
                "type": "tool-call",
                "toolCallId": "call_1",
                "toolName": "search",
                "input": {
                  "q": "cats"
                }
              },
              {
                "type": "tool-call",
                "toolCallId": "call_2",
                "toolName": "fetch",
                "input": {
                  "url": "https://x"
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": [
              {
                "type": "tool-result",
                "toolCallId": "call_1",
                "toolName": "search",
                "output": {
                  "type": "text",
                  "value": "found 3"
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": [
              {
                "type": "tool-result",
                "toolCallId": "call_2",
                "toolName": "fetch",
                "output": {
                  "type": "text",
                  "value": "a\nb"
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": [
              {
                "type": "tool-result",
                "toolCallId": "call_missing",
                "toolName": "",
                "output": {
                  "type": "text",
                  "value": "orphan"
                }
              }
            ]
          }
        ],
        "max_tokens": 64000,
